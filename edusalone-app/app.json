{
  "expo": {
    "name": "EduSalone",
    "slug": "palmtech-edusalone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "edusalone",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A365D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.palmtech.edusalone",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow EduSalone to take photos for chat and profiles.",
        "NSPhotoLibraryUsageDescription": "Allow EduSalone to access your photos for chat attachments.",
        "NSMicrophoneUsageDescription": "Allow EduSalone to record voice notes for chat messages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1A365D"
      },
      "package": "com.palmtech.edusalone",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "VIBRATE",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow EduSalone to take photos for chat.",
          "photosPermission": "Allow EduSalone to access your photos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow EduSalone to record voice notes."
        }
      ],
      "expo-notifications",
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "e91f508c-2d77-4ff4-a87c-dcf02deee385"
      }
    }
  }
}